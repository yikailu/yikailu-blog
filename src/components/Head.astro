---
import { SITE } from "@/config/site";
import { getCanonicalUrl, toAbsoluteUrl } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  type?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  keywords?: readonly string[];
}

const {
  title = SITE.title,
  description = SITE.description,
  pathname = "/",
  type = "website",
  publishedTime,
  updatedTime,
  keywords = []
} = Astro.props;

const canonical = getCanonicalUrl(pathname);
const fullTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const socialImage = toAbsoluteUrl(SITE.socialImage);
const mergedKeywords = [...new Set([...SITE.keywords, ...keywords])];
const keywordsContent = mergedKeywords.join(", ");
const isHomePage = pathname === "/";
const structuredData =
  type === "article" && publishedTime
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        url: canonical,
        datePublished: publishedTime,
        ...(updatedTime ? { dateModified: updatedTime } : {}),
        author: {
          "@type": "Person",
          name: SITE.author
        },
        publisher: {
          "@type": "Person",
          name: SITE.author
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonical
        },
        image: [socialImage],
        keywords: keywordsContent,
        inLanguage: SITE.lang
      }
    : isHomePage
      ? {
          "@context": "https://schema.org",
          "@type": "Blog",
          name: SITE.title,
          description,
          url: SITE.website,
          inLanguage: SITE.lang,
          author: {
            "@type": "Person",
            name: SITE.author
          },
          image: socialImage
        }
    : {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: fullTitle,
        description,
        url: canonical,
        inLanguage: SITE.lang,
        isPartOf: {
          "@type": "WebSite",
          name: SITE.title,
          url: SITE.website
        }
      };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywordsContent} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index,follow" />
<meta name="author" content={SITE.author} />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#ffffff" />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={SITE.lang} href={canonical} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={SITE.socialImageAlt} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={SITE.socialImageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{updatedTime && <meta property="article:modified_time" content={updatedTime} />}
{type === "article" &&
  keywords.map((keyword) => <meta property="article:tag" content={keyword} />)}
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
