---
import Head from "@/components/Head.astro";
import { SITE } from "@/config/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  type?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  keywords?: readonly string[];
}

const {
  title,
  description,
  pathname,
  type = "website",
  publishedTime,
  updatedTime,
  keywords
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head
      title={title}
      description={description}
      pathname={pathname}
      type={type}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      keywords={keywords}
    />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">
            <img class="brand__icon" src="/brand-icon.png" alt="" width="64" height="64" />
          </span>
          <span class="brand__copy">
            <span class="brand__title">{SITE.title}</span>
            <span class="brand__meta">{SITE.profile}</span>
          </span>
        </a>
        <nav class="nav" aria-label="主要导航">
          {SITE.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p class="footer-note">© {new Date().getFullYear()} IMAI</p>
      </div>
    </footer>
  </body>
</html>
