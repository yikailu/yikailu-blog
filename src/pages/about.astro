---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const aboutPage = await getEntry("pages", "about");

if (!aboutPage) {
  throw new Error("About page content is missing.");
}

const { Content } = await render(aboutPage);
const title = aboutPage.data.title;
const description = aboutPage.data.description;
---

<BaseLayout title={title} description={description} pathname="/about/">
  <article class="post">
    <div class="post-header">
      <p class="eyebrow">About</p>
      <h1 class="page-title">{title}</h1>
    </div>
    <div class="post-content">
      <div class="content-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
